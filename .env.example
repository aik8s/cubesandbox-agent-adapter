CUBE_ADAPTER_BIND=0.0.0.0
CUBE_ADAPTER_PORT=18080
CUBE_ADAPTER_TOKEN=replace-with-openssl-rand-hex-32
CUBE_ADAPTER_HMAC_KEY=replace-with-an-independent-openssl-rand-hex-32
CUBE_ADAPTER_AUDIT_LOG=/var/log/cube-adapter/audit.jsonl
CUBE_ADAPTER_AUDIT_UI=0
CUBE_ADAPTER_AUDIT_SINKS=file
CUBE_ADAPTER_ADMIN_ENABLED=1
CUBE_ADAPTER_PROFILES_FILE=/etc/cube-adapter/profiles.yaml
# Optional durable/multi-replica state. Generate the encryption key with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# CUBE_ADAPTER_STATE_BACKEND_URL=redis://redis:6379/0
# CUBE_ADAPTER_STATE_ENCRYPTION_KEY=
# CUBE_ADAPTER_STATE_PREFIX=cube-agent-adapter
CUBE_TEMPLATE_ID=agent-code
CUBE_API_URL=http://host.docker.internal:13000
# Required when CubeAPI authentication is enabled.
# CUBE_API_KEY=
CUBE_PROXY_NODE_IP=host.docker.internal
CUBE_PROXY_PORT_HTTP=13080
# Optional OIDC or TLS/mTLS settings are documented in README.md.
